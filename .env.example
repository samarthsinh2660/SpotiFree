# Spotify — OPTIONAL, and only useful if the app owner has Premium.
# Without it, playlists are read from the public embed page (no auth needed).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube — https://console.cloud.google.com
# Create project → APIs & Services → Enable "YouTube Data API v3" → Credentials → API key
YOUTUBE_API_KEY=

PORT=3000
